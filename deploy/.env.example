# Copy to .env and adjust. See GAP-003.md for dev/staging/production matrix.
# https://github.com/.../blob/main/.cursor/gaps-p0/GAP-003.md

# --- Runtime ---
TDTD_ENV=production
PORT=3000
TDTD_DB_PATH=/data/teacher_app.sqlite
TDTD_TIMEZONE=Asia/Manila
TDTD_REPORT_OUTPUT_DIR=/data/reports

# --- Secrets (generate with: openssl rand -base64 48) ---
TDTD_JWT_ACCESS_SECRET=change-me-use-openssl-rand-base64-48
TDTD_REFRESH_TOKEN_PEPPER=change-me-use-openssl-rand-base64-48

# --- CORS (comma-separated origins, no trailing slashes) ---
# Web + Capacitor WebView origins as needed:
# TDTD_CORS_ORIGINS=https://app.example.com,capacitor://localhost,https://localhost
TDTD_CORS_ORIGINS=http://localhost:5173

# --- App URL (password reset links) ---
TDTD_APP_URL=http://localhost:5173

# --- SMTP (required for forgot-password in staging/production) ---
# TDTD_SMTP_HOST=smtp.example.com
# TDTD_SMTP_PORT=587
# TDTD_SMTP_USER=
# TDTD_SMTP_PASS=
# TDTD_SMTP_FROM=noreply@example.com

# --- TLS profile (caddy service) ---
# API_DOMAIN=api.example.com
# ACME_EMAIL=ops@example.com

# --- Backup profile ---
TDTD_BACKUP_DIR=/data/backups
TDTD_BACKUP_RETENTION_DAYS=14

# --- Published port (api service) ---
API_PORT=3000
