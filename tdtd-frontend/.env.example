# Copy to .env.local (gitignored) and adjust for your setup.
# Restart `npm run dev` after changes.

# --- Local dev (default) ---
# Omit VITE_API_URL or leave unset: browser calls http://127.0.0.1:3000 directly.
# See tdtd-frontend/src/lib/http.ts

# --- Option B — ngrok API tunnel (two tunnels) ---
# Set to the HTTPS URL from `ngrok http 3000` (no trailing slash).
# Share the UI via a separate `ngrok http 5173` tunnel.
# VITE_API_URL=https://your-subdomain.ngrok-free.app

# --- Option A — single ngrok tunnel to Vite only ---
# Use empty value so requests use relative /api and Vite proxies to localhost:3000.
# VITE_API_URL=

# --- Production build (same origin) ---
# Build with empty VITE_API_URL when the API is served under /api on the same host.
# VITE_API_URL=

# --- Mobile (Capacitor) ---
# Set for installable iOS/Android builds (enables offline paths in src/mobile/).
# VITE_APP_TARGET=mobile
# Point at your hosted API (required for sync when online):
# VITE_API_URL=https://api.example.com
