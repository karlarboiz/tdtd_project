# Copy to .env.local (gitignored) for local `npm start`.
# Full matrix: .cursor/gaps-p0/GAP-003.md

# --- Environment ---
# TDTD_ENV=development
# NODE_ENV=development
PORT=3000

# --- Database ---
# Default: data/teacher_app.sqlite relative to tdtd-node cwd
# TDTD_DB_PATH=data/teacher_app.sqlite

# --- Auth secrets ---
# Unset in dev → dev placeholders in auth-config.ts (NOT for production)
# TDTD_JWT_ACCESS_SECRET=
# TDTD_REFRESH_TOKEN_PEPPER=

# Token TTLs (optional)
# TDTD_ACCESS_TOKEN_TTL_MINUTES=15
# TDTD_REFRESH_TOKEN_TTL_DAYS=14
# TDTD_PASSWORD_MAX_AGE_DAYS=60
# TDTD_PASSWORD_RESET_TTL_MINUTES=60

# --- CORS ---
# Unset in dev → reflect any origin (ngrok/LAN). Required when TDTD_ENV=production.
# TDTD_CORS_ORIGINS=http://localhost:5173

# --- App ---
# TDTD_APP_URL=http://localhost:5173
# TDTD_TIMEZONE=Asia/Manila

# --- Reports (on-demand batch JAR spawn) ---
# TDTD_REPORT_OUTPUT_DIR=data/reports

# --- SMTP (optional in dev — reset links logged to console) ---
# TDTD_SMTP_HOST=
# TDTD_SMTP_PORT=587
# TDTD_SMTP_USER=
# TDTD_SMTP_PASS=
# TDTD_SMTP_FROM=
